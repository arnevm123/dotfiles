#!/usr/bin/env bash
# Manage grove worktrees with tmux integration

# Get the current path relative to home, removing the deepest folder
relative_path="${PWD#"$HOME"/}"
base_path="${relative_path%/*}"

# If no arguments, use fzf to select from grove list
if [[ $# -eq 0 ]]; then
	mapfile -t worktrees < <(grove --plain list 2>/dev/null | awk '/^\*/ {print $2} /^  / {print $1}')
	folders=()
	for wt in "${worktrees[@]}"; do
		folders+=("$HOME/$base_path/$wt")
	done
	"$HOME"/bin/tmux-sessionizer --folders "${folders[@]}"
	exit 0
fi

# Handle --pr flag
if [[ "$1" == "--pr" && -n "$2" ]]; then
	pr_num="$2"
	shift 2
	pr_args=("--pr" "$pr_num" "$@")

	custom_name=""
	if [[ "$*" != *"--name"* ]]; then
		read -rp "Worktree name (blank for 'pr-$pr_num'): " custom_name
		if [[ -n "$custom_name" ]]; then
			pr_args+=("--name" "$custom_name")
		fi
	fi

	grove add "${pr_args[@]}"

	wt_name="pr-$pr_num"
	if [[ -n "$custom_name" ]]; then
		wt_name="$custom_name"
	fi

	touch "$base_path/$wt_name/.tmux-sessionizer"
	"$HOME"/bin/tmux-sessionizer "$base_path/$wt_name"
	exit 0
fi

# Handle --name flag: grove-tmux [branch] --name [custom_name]
branch="$1"
shift
grove_args=("$branch")

# Pass through remaining arguments (including --name)
grove_args+=("$@")

# If no --name was given, ask for one (falls back to the branch name if left blank)
custom_name=""
if [[ "$*" != *"--name"* ]]; then
	read -rp "Worktree name (blank for '${branch//\//-}'): " custom_name
	if [[ -n "$custom_name" ]]; then
		grove_args+=("--name" "$custom_name")
	fi
fi

grove add "${grove_args[@]}"

# Determine the worktree directory name
if [[ -n "$custom_name" ]]; then
	wt_name="$custom_name"
elif [[ "$*" == *"--name"* ]]; then
	# Extract the name after --name
	prev_arg=""
	for arg in "$@"; do
		if [[ "$prev_arg" == "--name" ]]; then
			wt_name="$arg"
			break
		fi
		prev_arg="$arg"
	done
else
	# Grove will create a directory from the branch name (replace / with -)
	wt_name="${branch//\//-}"
fi

touch "$HOME/$base_path/$wt_name/.tmux-sessionizer"
"$HOME"/bin/tmux-sessionizer "$base_path/$wt_name"
